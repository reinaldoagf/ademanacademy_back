// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 💡 MODELO: USUARIOS
model User {
  id                String       @id @default(uuid())
  dni               String       @unique @db.VarChar(30) // 💡 Añadido DNI único
  name              String       @db.VarChar(150)
  email             String       @unique @db.VarChar(180)
  password          String?      @db.VarChar(255)
  isAdmin           Boolean      @default(false)
  profileOnboarding Boolean      @default(false)
  profileType       ProfileType?
  createdAt         DateTime     @default(now()) @map("createdAt")
  updatedAt         DateTime     @updatedAt @map("updatedAt")

  // Relación inversa: Un usuario puede tener muchos representados
  student      Student[]
  transactions Transaction[]

  @@map("users")
}

// 💡 MODELO: REPRESENTADOS
model Student {
  id                  String   @id @default(uuid())
  dni                 String   @unique @db.VarChar(30) // 💡 Añadido DNI único
  firstName           String   @db.VarChar(150)
  lastName            String   @db.VarChar(150)
  birthDate           DateTime @db.Date
  kinship             Kinship  @default(Hijo)
  medicalObservations String?  @db.Text

  // 💡 CORRECCIÓN: Volvemos opcional el objeto relacional y su llave foránea
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @db.VarChar(36) // Ahora acepta NULL en MySQL si el Admin registra al estudiante directamente

  transactions Transaction[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("students")
}

model Transaction {
  id     String @id @default(cuid()) // Generará IDs únicos estables
  userId String // Llave foránea hacia tu tabla de Usuario
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  studentId String? // Llave foránea hacia tu tabla de Alumnos
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  concept ConceptType
  amount  Decimal           @db.Decimal(10, 2) // Recomendado para datos financieros (previene bugs de flotantes)
  method  PaymentMethod
  status  TransactionStatus @default(pendiente)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

enum ConceptType {
  mensualidad   @map("Mensualidad")
  matricula     @map("Matrícula")
  uniforme      @map("Uniforme")
  entradas_gala @map("Entradas Gala")
}

enum PaymentMethod {
  transferencia @map("Transferencia")
  tarjeta       @map("Tarjeta")
  efectivo      @map("Efectivo")
  pago_movil    @map("Pago Móvil")
}

enum TransactionStatus {
  aprobado  @map("Aprobado")
  pendiente @map("Pendiente")
}

// Enum para limitar los tipos de perfiles 
enum ProfileType {
  representative
  student
}

// Enum para limitar los parentescos permitidos
enum Kinship {
  Hijo
  Hija
  Sobrino
  Sobrina
  Tutorado
  Otro
}

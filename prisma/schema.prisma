// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 💡 MODELO: USUARIOS
model User {
  id                String         @id @default(uuid())
  IDNumberPrefix    String         @db.VarChar(30)
  dni               String         @unique @db.VarChar(30) // 💡 Añadido DNI único
  firstName         String         @db.VarChar(150)
  lastName          String         @db.VarChar(150)
  birthDate         DateTime       @db.Date
  email             String         @unique @db.VarChar(180)
  countryCode       String?        @db.VarChar(40) // Opcional
  phone             String         @unique @db.VarChar(180)
  password          String?        @db.VarChar(255)
  isAdmin           Boolean        @default(false)
  profileOnboarding Boolean        @default(false)
  profileType       ProfileType?
  // 🎯 NUEVO: Ocupación exclusiva para cuando el usuario actúa como Representante
  occupation        String?        @db.VarChar(150) // 🔴 CORRECCIÓN: 1-a-1 Opcional (Agregado @unique y eliminado arreglos)
  otpCode           String?        @db.VarChar(180)
  otpCodeExpiry     DateTime?
  // 🔑 Relación 1:1 - Lado que guarda la FK (Foreign Key)
  // Se requiere @unique para que no se repita el mismo empleado en varios usuarios
  // Lado inverso de la relación 1:1
  employee          Employee?
  // Relación inversa: Un usuario puede tener muchos representados
  transactions      Transaction[]
  groups            Group[]
  registrations     Registration[]
  notifications     Notification[]

  createdAt     DateTime       @default(now()) @map("createdAt")
  updatedAt     DateTime       @updatedAt @map("updatedAt")
  eventSeats    EventSeat[]
  paymentOrders PaymentOrder[]
  // 🎯 RELACIONES CON CLIENTES:
  // 1. Clientes donde este usuario es el propio cliente (su propio usuario)
  ownedClients  Client[]       @relation(name: "ClientUser")

  // 2. Clientes donde este usuario actúa como representante
  representedClients Client[] @relation(name: "ClientRepresentative")

  @@map("users")
}

// 💡 MODELO: REPRESENTADOS
model Employee {
  id                  String         @id @default(uuid())
  IDNumberPrefix      String?        @db.VarChar(30)
  dni                 String?        @db.VarChar(30)
  firstName           String         @db.VarChar(150)
  lastName            String         @db.VarChar(150)
  birthDate           DateTime       @db.Date
  typeOfContract      TypeOfContract @default(Fijo)
  typeOfEmployee      TypeOfEmployee @default(Administrativo)
  medicalObservations String?        @db.Text
  address             String         @db.Text
  countryCode         String?        @db.VarChar(40) // Opcional
  phone               String?        @db.VarChar(40) // Opcional
  // 🌟 CAMPOS DE NÓMINA
  baseSalary          Decimal?       @db.Decimal(10, 2) // Salario base para empleados Fijos
  hoursTaughtMonth    Int            @default(1)
  hourlyRate          Decimal        @db.Decimal(10, 2)
  payrollStatus       PayrollStatus  @default(Pendiente)
  // Lado que guarda la FK
  userId              String?        @unique @db.VarChar(36)
  user                User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  groups Group[]

  createdAt     DateTime       @default(now()) @map("createdAt")
  updatedAt     DateTime       @updatedAt @map("updatedAt")
  fixedExpenses FixedExpense[]

  @@map("employees")
}

// 💡 MODELO: REPRESENTADOS
model Student {
  id                  String           @id @default(uuid())
  shirtSize           String           @db.VarChar(10) // Ej: "12", "M"
  kinship             Kinship          @default(Hijo)
  medicalObservations String?          @db.Text
  hasExperience       Boolean          @default(false)
  group               Group?           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId             String?
  clients             Client[]
  uniformAssignments  StudentUniform[]
  costumeAssignments  StudentCostume[]

  createdAt          DateTime          @default(now()) @map("createdAt")
  updatedAt          DateTime          @updatedAt @map("updatedAt")
  registrations      Registration[]
  paymentOrders      PaymentOrder[]
  specialRehearsal   SpecialRehearsal? @relation(fields: [specialRehearsalId], references: [id])
  specialRehearsalId String?

  @@map("students")
}

model Client {
  id             String   @id @default(uuid())
  IDNumberPrefix String?  @db.VarChar(30)
  dni            String?  @db.VarChar(30)
  firstName      String   @db.VarChar(150)
  lastName       String   @db.VarChar(150)
  email          String?  @unique @db.VarChar(180)
  birthDate      DateTime @db.Date

  // 🎯 NUEVOS CAMPOS DEL ALUMNO
  address     String  @db.Text
  countryCode String? @db.VarChar(40) // Opcional
  phone       String? @db.VarChar(40) // Opcional

  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId String?

  transactions  Transaction[]
  paymentOrders PaymentOrder[]
  orders        Order[]
  orderItems    OrderItem[]
  type          ClientType     @default(Representante)

  registrations Registration[]
  eventSeats    EventSeat[]

  group           Group?           @relation(fields: [groupId], references: [id])
  groupId         String?
  studentUniforms StudentUniform[]
  studentCostumes StudentCostume[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  // 🎯 NUEVAS RELACIONES LIMPIAS CON USUARIOS (Ambas opcionales)

  // A. El usuario propio del cliente
  user   User?   @relation(name: "ClientUser", fields: [userId], references: [id], onDelete: Cascade)
  userId String? @db.VarChar(36)

  // B. El usuario del representante
  representative   User?   @relation(name: "ClientRepresentative", fields: [representativeId], references: [id], onDelete: SetNull)
  representativeId String? @db.VarChar(36)

  @@map("clients")
}

model Order {
  id       String @id @default(uuid())
  clientId String @db.VarChar(36)
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(Pendiente) // Estado logístico
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items        OrderItem[] // El desglose de lo que compró (2 uniformes, 1 entrada...)
  paymentOrder PaymentOrder? // Relación 1-a-1: Este pedido genera ÚNICAMENTE UNA orden de pago

  @@map("orders")
}

model OrderItem {
  id          String               @id @default(uuid())
  concept     OrderItemConceptType // Mensualidad/Matrícula no aplican aquí, pero Vestuario y Entradas sí.
  description String?              @db.VarChar(36)
  quantity    Int                  @default(1)
  price       Decimal              @db.Decimal(10, 2) // Precio unitario al momento de la compra

  orderId  String  @db.VarChar(255)
  order    Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  clientId String? @db.VarChar(36)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

// =========================================================================
// 🎯 2. TABLA DE ÓRDENES DE PAGO (FINANZAS / CUENTAS POR COBRAR)
// =========================================================================

model PaymentOrder {
  id        String   @id @default(cuid())
  clientId  String?  @db.VarChar(36)
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  // 🎯 NUEVO: Relación opcional con el estudiante específico de esta mensualidad/pago
  studentId String?  @db.VarChar(36)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // 🔗 Conexión opcional con Pedidos: 
  // - Si viene de la tienda, se conecta a un 'OrderId'.
  // - Si es una mensualidad automática del sistema, 'orderId' queda NULL porque no nace de una compra.
  orderId   String?  @unique @db.VarChar(255)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  concept ConceptType
  amount  Decimal            @db.Decimal(10, 2)
  dueDate DateTime?          @db.Date
  status  PaymentOrderStatus @default(Pendiente) // Estado del dinero

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions      Transaction[] // Una orden de pago puede tener varios intentos de transacciones
  eventSeats        EventSeat[] // Relación 1 a N con asientos
  registeringUser   User?         @relation(fields: [registeringUserId], references: [id])
  registeringUserId String?

  @@map("payment_orders")
}

model Product {
  id                String           @id @default(cuid())
  name              String           @unique
  description       String?          @db.Text
  salePrice         Decimal          @db.Decimal(10, 2)
  cost              Decimal          @db.Decimal(10, 2)
  currentStock      Int              @default(1)
  minimumStockAlert Int              @default(1)
  images            ProductImage[] // Lista de imágenes
  isActive          Boolean          @default(true) // Control de visibilidad
  featured          Boolean          @default(false) // Destacado
  categoryId        String?
  category          ProductCategory? @relation(fields: [categoryId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

model ProductImage {
  id      String  @id @default(uuid())
  url     String // URL absoluta de S3 o CDN
  key     String  @unique // Clave/Path del objeto en S3 (ej: events/abc-123.jpg)
  altText String?
  type    String  @default("gallery") // 'cover' | 'gallery'
  order   Int     @default(0)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("product_images")
}

model ProductCategory {
  id        String    @id @default(uuid())
  name      String    @unique
  // Relación inversa: Un salón puede albergar múltiples grupos
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("product_categories")
}

// =========================================================================
// 🎯 3. TABLA DE TRANSACCIONES (CAJA / CONTROL DE EFECTIVO Y BANCOS)
// =========================================================================

model Transaction {
  id                String  @id @default(cuid())
  registeringUserId String  @db.VarChar(36) // registered by user
  registeringUser   User    @relation(fields: [registeringUserId], references: [id], onDelete: Cascade)
  clientId          String? @db.VarChar(36)
  client            Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // 🔗 Conexión con la Orden de Pago: Toda transacción debe saldar una deuda (Orden de Pago)
  paymentOrderId String?       @db.VarChar(255)
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  concept ConceptType
  amount  Decimal           @db.Decimal(10, 2)
  method  PaymentMethod
  status  TransactionStatus @default(Pendiente)

  // Datos de auditoría bancaria (Opcionales pero recomendados para Transferencias/Pago Móvil)
  referenceNumber       String?                @db.VarChar(100)
  bankName              String?                @db.VarChar(100)
  //receiptPath     String? @db.VarChar(255)
  imageOfPaymentReceipt ImageOfPaymentReceipt? // Lista de imágenes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model ImageOfPaymentReceipt {
  id      String  @id @default(uuid())
  url     String // URL absoluta de S3 o CDN
  key     String  @unique // Clave/Path del objeto en S3 (ej: events/abc-123.jpg)
  altText String?

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("image_of_payment_receipts")
}

model WeeklySchedule {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Almacena el objeto WeeklySchedule completo (Dias y sus bloques de horas)
  // Ej: { "lunes": [{ "id": "...", "startTime": "14:30", "endTime": "16:00", "label": "Salsa Casino" }] }
  schedule Json    @default("{\"lunes\": [], \"martes\": [], \"miércoles\": [], \"jueves\": [], \"viernes\": [], \"sábado\": [], \"domingo\": []}")
  // Relación con el Grupo
  group    Group?  @relation(fields: [groupId], references: [id])
  groupId  String?

  // Relación con el Salón de clases (Para saber qué salón está ocupado en este horario)
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?

  @@map("schedules")
}

model GroupCategory {
  id         String   @id @default(uuid())
  name       String   @unique
  minimumAge Int      @default(1)
  maximumAge Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relación inversa: Un salón puede albergar múltiples grupos
  groups Group[]

  @@map("group_categories")
}

model Group {
  id                 String           @id @default(uuid())
  name               String           @unique
  totalNumberOfSlots Int              @default(1)
  instructorId       String?          @db.VarChar(36)
  instructor         Employee?        @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  classroomId        String?
  classroom          Classroom?       @relation(fields: [classroomId], references: [id])
  categoryId         String?
  category           GroupCategory?   @relation(fields: [categoryId], references: [id])
  userId             String?
  user               User?            @relation(fields: [userId], references: [id])
  // Relación inversa: Un salón puede albergar múltiples grupos
  schedules          WeeklySchedule[]
  clients            Client[]
  registrations      Registration[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]

  @@map("groups")
}

model Classroom {
  id          String          @id @default(uuid())
  address     String          @db.Text
  name        String          @unique
  maxCapacity Int
  type        ClassroomType
  status      ClassroomStatus @default(Activo)
  description String?

  // Relación inversa: Un salón puede albergar múltiples grupos
  groups    Group[]
  // Relación inversa añadida: Un salón puede tener muchos horarios registrados
  schedules WeeklySchedule[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  specialRehearsals SpecialRehearsal[]

  @@map("classrooms")
}

model Registration {
  id        String             @id @default(uuid())
  status    RegistrationStatus @default(Pendiente)
  userId    String?            @db.VarChar(36)
  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String?            @db.VarChar(36)
  student   Student?           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  groupId   String?
  group     Group?             @relation(fields: [groupId], references: [id])
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  client    Client?            @relation(fields: [clientId], references: [id])
  clientId  String?

  @@map("registrations")
}

model Uniform {
  id                 String             @id @default(uuid())
  name               String             @unique @db.VarChar(150)
  category           LockerRoomCategory @default(Bebé)
  status             LockerRoomStatus   @default(Pendiente_por_Pago)
  price              Decimal            @db.Decimal(10, 2) // Precio unitario al momento de la compra 
  // Guardar el inventario por tallas en JSON sigue siendo válido si es informativo, 
  // pero lo ideal para asignaciones exactas es registrar qué talla se lleva el alumno en la tabla intermedia.
  availableSizes     Json               @default("[]")
  images             UniformImage[] // Lista de imágenes
  // 🎯 RELACIÓN NUEVA: Alumnos a los que se ha asignado este vestuario
  uniformAssignments StudentUniform[]
  createdAt          DateTime           @default(now()) @map("createdAt")
  updatedAt          DateTime           @updatedAt @map("updatedAt")

  @@map("uniforms")
}

model UniformImage {
  id      String  @id @default(uuid())
  url     String // URL absoluta de S3 o CDN
  key     String  @unique // Clave/Path del objeto en S3 (ej: events/abc-123.jpg)
  altText String?
  type    String  @default("gallery") // 'cover' | 'gallery'
  order   Int     @default(0)

  uniformId String
  uniform   Uniform @relation(fields: [uniformId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("uniform_images")
}

model StudentUniform {
  id String @id @default(uuid())

  // Relación con el Estudiante
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Relación con el Vestuario
  uniformId String
  uniform   Uniform @relation(fields: [uniformId], references: [id], onDelete: Cascade)

  // Datos específicos de la asignación
  assignedSize String           @db.VarChar(10) // La talla exacta que se le entregó (ej: "M", "12")
  status       AssignmentStatus @default(Asignado)
  observations String?          @db.Text // Ej: "Se entrega con detalles en encaje", "Falta tiara"

  // Fechas de control
  assignedAt DateTime  @default(now()) // Cuándo se le dio
  returnedAt DateTime? // Cuándo lo devolvió (si aplica)

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")
  client    Client?  @relation(fields: [clientId], references: [id])
  clientId  String?

  @@map("student_uniforms")
}

// 👗 MODELO DE VESTUARIO (Optimizado)
model Costume {
  id       String             @id @default(uuid())
  name     String             @unique @db.VarChar(150)
  beat     String?            @db.VarChar(100) // Ritmo / Temática del baile
  category LockerRoomCategory @default(Bebé)
  status   LockerRoomStatus   @default(Pendiente_por_Pago)
  price    Decimal            @db.Decimal(10, 2) // Precio unitario al momento de la compra

  // 🎯 RELACIÓN NUEVA: Galería de imágenes guardada como un array JSON de strings
  images             CostumeImage[] // Lista de imágenes
  // 🎯 RELACIÓN NUEVA: Alumnos a los que se ha asignado este vestuario
  costumeAssignments StudentCostume[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("costumes")
}

model CostumeImage {
  id      String  @id @default(uuid())
  url     String // URL absoluta de S3 o CDN
  key     String  @unique // Clave/Path del objeto en S3 (ej: events/abc-123.jpg)
  altText String?
  type    String  @default("gallery") // 'cover' | 'gallery'
  order   Int     @default(0)

  costumeId String
  costume   Costume @relation(fields: [costumeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("costume_images")
}

// 🤝 TABLA INTERMEDIA: Registro exacto de Asignaciones de Vestuarios
model StudentCostume {
  id String @id @default(uuid())

  // Relación con el Estudiante
  student   Student @relation(fields: [studentId], references: [id])
  studentId String

  // Relación con el Vestuario
  costumeId String
  costume   Costume @relation(fields: [costumeId], references: [id], onDelete: Cascade)

  // Datos específicos de la asignación
  assignedSize String?          @db.VarChar(10) // La talla exacta que se le entregó (ej: "M", "12")
  status       AssignmentStatus @default(Asignado)
  observations String?          @db.Text // Ej: "Se entrega con detalles en encaje", "Falta tiara"

  // Fechas de control
  assignedAt DateTime  @default(now()) // Cuándo se le dio
  returnDate DateTime? @db.Date
  returnedAt DateTime? // Cuándo lo devolvió (si aplica)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client?  @relation(fields: [clientId], references: [id])
  clientId  String?

  @@map("student_costumes")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique @db.VarChar(30)
  value     String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Supplier {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  dni       String  @unique
  email     String?
  phone     String?

  // Relación con sus Cuentas por Pagar
  payables AccountPayable[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  fixedExpenses FixedExpense[]
}

// ==========================================
// CUENTAS POR PAGAR (Facturas/Deudas de la empresa)
// ==========================================
model AccountPayable {
  id            String    @id @default(cuid())
  // Relación con Proveedor
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  // Información de la factura / proveedor
  supplierName  String // Nombre de la empresa o proveedor
  supplierDni   String? // RIF / DNI / NIT del proveedor
  invoiceNumber String? // Número de factura o nota de venta de origen
  concept       String // Concepto/Descripción (ej: "Compra de uniformes", "Alquiler")

  // Importes
  amountTotal     Float // Monto total de la deuda
  amountPaid      Float @default(0) // Suma total abonada hasta el momento
  amountRemaining Float // Monto restante por pagar (amountTotal - amountPaid)

  // Fechas clave
  issueDate DateTime @default(now()) // Fecha de emisión / registro
  dueDate   DateTime // Fecha límite / vencimiento del pago

  // Estado
  status PayableStatus @default(Pendiente)
  notes  String? // Observaciones o notas adicionales

  // Historial de abonos/pagos realizados
  payments PayablePayment[]

  // Auditoría
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dueDate])
  @@map("account_payables")
}

// ==========================================
// ABONOS / PAGOS REALIZADOS A UNA CXP
// ==========================================
model PayablePayment {
  id String @id @default(uuid())

  // Relación con la Cuenta por Pagar
  accountPayableId String
  accountPayable   AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)

  // Datos de la transacción
  amount          Float // Monto del abono/pago realizado
  paymentDate     DateTime      @default(now()) // Fecha en que se hizo el pago
  method          PaymentMethod @default(Pago_Movil)
  referenceNumber String? // Número de referencia / depósito / transferencia

  // Comprobante o soporte
  receiptUrl String? // Enlace al archivo/imagen del comprobante

  notes String? // Comentario sobre el abono

  // Auditoría
  createdAt DateTime @default(now())

  @@index([accountPayableId])
  @@map("payable_payments")
}

// Modelo de Evento
model Event {
  id               String    @id @default(uuid())
  name             String
  type             EventType @default(Gala_Anual)
  startDate        DateTime // Fecha de inicio
  endDate          DateTime // Fecha de fin (puede ser igual a startDate)
  publishToHome    Boolean   @default(true) // ¿Publicar en la página principal?
  isPresaleActive  Boolean   @default(false)
  // 🎯 2. Fechas de Preventa
  presaleStartDate DateTime? // Inicio de preventa (opcional)
  presaleEndDate   DateTime? // Fin de preventa (opcional)

  productionStatus ProductionStatus @default(Planificación)
  description      String?          @db.Text
  isActive         Boolean          @default(true)
  ticketsSold      Float?           @default(0)

  // 🎯 1. Imágenes referentes al evento
  // 🎯 Relación 1-a-Muchos fuertemente tipada para Galería de Imágenes
  images EventImage[]

  // 🎯 3. Marcas patrocinantes
  sponsors     Sponsor[]
  // 🎯 NUEVO: Relación opcional con el Mapa de Asientos que usará este evento
  seatingMapId String?
  seatingMap   SeatingMap? @relation(fields: [seatingMapId], references: [id], onDelete: SetNull)

  // 🎯 NUEVO: Relación con el estado de los asientos para este evento específico
  eventSeats EventSeat[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@map("events")
}

model EventImage {
  id      String  @id @default(uuid())
  url     String // URL absoluta de S3 o CDN
  key     String  @unique // Clave/Path del objeto en S3 (ej: events/abc-123.jpg)
  altText String?
  type    String  @default("gallery") // 'cover' | 'gallery'
  order   Int     @default(0)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("event_images")
}

// 🎯 NUEVO: Modelo para Patrocinadores y sus Redes Sociales
model Sponsor {
  id         String      @id @default(uuid())
  name       String
  logoUrl    String      @db.Text
  tier       SponsorTier @default(Plata) // Nivel de patrocinio
  websiteUrl String?

  // Redes sociales estructuradas en JSON o como campos opcionales
  socialLinks Json? // Ejemplo: { "instagram": "@marca", "twitter": "https://..." }

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sponsors")
}

model SeatingMap {
  id          String              @id @default(uuid())
  location    String?
  totalWidth  Float
  totalHeight Float
  elements    SeatingMapElement[]
  events      Event[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("seating_maps")
}

model SeatingMapElement {
  id                     String             @id @default(uuid())
  itemID                 String // ID visual/lógico asignado desde el canvas
  type                   SeatingMapType     @default(Silla) // "tarima_pista" | "silla_vip" | etc.
  itemType               SeatingMapItemType @default(Silla_General)
  name                   String
  chairNumber            String?
  groupId                String?
  macroGroupId           String?
  rotation               Float
  groupRotation          Float?
  presalePrice           Float              @default(0.00)
  salePrice              Float              @default(0.00)
  x                      Float?
  y                      Float?
  width                  Float?
  height                 Float?
  xMeters                Float
  yMeters                Float
  widthMeters            Float
  heightMeters           Float
  limitPerRepresentative Float?

  // Relación con el Mapa de Asientos
  seatingMapId String
  seatingMap   SeatingMap  @relation(fields: [seatingMapId], references: [id], onDelete: Cascade)
  // 🎯 NUEVO: Relación inversa para saber en qué eventos se está usando este elemento
  eventSeats   EventSeat[]

  @@index([seatingMapId])
  @@map("seating_map_elements")
}

// NUEVO MODELO: Controla el estado dinámico del asiento por cada Evento
model EventSeat {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  seatingMapElementId String
  seatingMapElement   SeatingMapElement @relation(fields: [seatingMapElementId], references: [id], onDelete: Cascade)

  status SeatStatus @default(Disponible)

  // ⏱️ Control de los 10 minutos de reserva temporal
  reservedAt DateTime?
  expiresAt  DateTime? // Fecha/Hora exacta en que caduca la reserva temporal

  // 👤 Quién lo reservó o compró
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // 🔗 Conexión con la Orden de Pago
  paymentOrderId String?       @db.VarChar(255)
  paymentOrder   PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🛡️ Restricción crítica: Una misma silla física no puede tener registros duplicados para el mismo evento
  @@unique([eventId, seatingMapElementId])
  @@index([eventId])
  @@index([status])
  @@map("event_seats")
}

// ==========================================
// MÓDULO DE NOTIFICACIONES (Realtime & WhatsApp)
// ==========================================

model Notification {
  id      String              @id @default(uuid())
  title   String              @db.VarChar(150)
  message String              @db.Text
  link    String?             @db.VarChar(150)
  channel NotificationChannel @default(Aplicación)
  status  NotificationStatus  @default(Pendiente)

  // Relación opcional con el Usuario destinatario
  userId String? @db.VarChar(36)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Número de teléfono si es enviado vía WhatsApp directamente
  recipientPhone String? @db.VarChar(40)

  // Metadatos adicionales (Ej: { orderId: "...", eventId: "..." })
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("notifications")
}

model FixedExpense {
  id          String           @id @default(uuid())
  title       String           @db.VarChar(150)
  description String?          @db.Text
  amount      Float // Monto del abono/pago realizado
  frequency   ExpenseFrequency @default(Mensual) // Frecuencia de repetición
  nextDueDate DateTime         @db.Date // Próxima fecha en que se genera la cuenta por pagar
  isActive    Boolean          @default(true)

  // Proveedor opcional asociado al gasto fijo
  supplierId String?   @db.VarChar(36)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  // 🌟 Empleado opcional (para gastos fijos de nómina)
  employeeId String?   @db.VarChar(36)
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("fixed_expenses")
}

model SpecialRehearsal {
  id          String   @id @default(uuid())
  title       String   @db.VarChar(150)
  description String?  @db.Text
  date        DateTime @db.Date // Fecha específica del ensayo (ej: 2026-06-15)
  startTime   String   @db.VarChar(10) // "14:30"
  endTime     String   @db.VarChar(10) // "16:00"

  // 🌟 Opcional: Salón dentro de la academia (si se realiza en las instalaciones)
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id], onDelete: SetNull)
  // 🌟 Nuevo: Ubicación libre en texto si es fuera de la academia
  location    String?    @db.VarChar(255)
  // Estudiantes participantes en el ensayo especial
  students    Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([classroomId])
  @@map("special_rehearsals")
}

enum ExpenseFrequency {
  Semanal
  Quincenal
  Mensual
  Anual
}


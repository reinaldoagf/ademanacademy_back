// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 💡 MODELO: USUARIOS
model User {
  id                String       @id @default(uuid())
  dni               String       @unique @db.VarChar(30) // 💡 Añadido DNI único
  name              String       @db.VarChar(150)
  email             String       @unique @db.VarChar(180)
  phone             String       @unique @db.VarChar(180)
  password          String?      @db.VarChar(255)
  isAdmin           Boolean      @default(false)
  isAnInstructor    Boolean      @default(false)
  profileOnboarding Boolean      @default(false)
  profileType       ProfileType?
  // 🎯 NUEVO: Ocupación exclusiva para cuando el usuario actúa como Representante
  occupation        String?      @db.VarChar(150)
  createdAt         DateTime     @default(now()) @map("createdAt")
  updatedAt         DateTime     @updatedAt @map("updatedAt")

  // Relación inversa: Un usuario puede tener muchos representados
  student       Student[]
  paymentOrders PaymentOrder[]
  orders        Order[]
  transactions  Transaction[]
  groups        Group[]

  @@map("users")
}

// 💡 MODELO: REPRESENTADOS
model Student {
  id                  String   @id @default(uuid())
  // 🎯 CAMBIO: El DNI del alumno ahora es opcional y NO unique para evitar fallos si varios alumnos no lo tienen
  dni                 String?  @db.VarChar(30)
  firstName           String   @db.VarChar(150)
  lastName            String   @db.VarChar(150)
  birthDate           DateTime @db.Date
  kinship             Kinship  @default(son)
  medicalObservations String?  @db.Text

  // 🎯 NUEVOS CAMPOS DEL ALUMNO
  address       String  @db.Text
  phone         String? @db.VarChar(40) // Opcional
  shirtSize     String  @db.VarChar(10) // Ej: "12", "M"
  hasExperience Boolean @default(false)
  group         String  @db.VarChar(50) // Ej: "baby_dance", "infantil"

  // 💡 CORRECCIÓN: Volvemos opcional el objeto relacional y su llave foránea
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @db.VarChar(36) // Ahora acepta NULL en MySQL si el Admin registra al estudiante directamente

  transactions  Transaction[]
  paymentOrders PaymentOrder[]
  orderItems    OrderItem[]

  createdAt DateTime @default(now()) @map("createdAt")
  updatedAt DateTime @updatedAt @map("updatedAt")

  @@map("students")
}

model Order {
  id     String @id @default(cuid())
  userId String @db.VarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalAmount Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(pending_preparation) // Estado logístico
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items        OrderItem[] // El desglose de lo que compró (2 uniformes, 1 entrada...)
  paymentOrder PaymentOrder? // Relación 1-a-1: Este pedido genera ÚNICAMENTE UNA orden de pago

  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String @db.VarChar(255)
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  studentId String?     @db.VarChar(36)
  student   Student?    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept   ConceptType // Mensualidad/Matrícula no aplican aquí, pero Vestuario y Entradas sí.
  quantity  Int         @default(1)
  price     Decimal     @db.Decimal(10, 2) // Precio unitario al momento de la compra

  @@map("order_items")
}

// =========================================================================
// 🎯 2. TABLA DE ÓRDENES DE PAGO (FINANZAS / CUENTAS POR COBRAR)
// =========================================================================

model PaymentOrder {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String?  @db.VarChar(36)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // 🔗 Conexión opcional con Pedidos: 
  // - Si viene de la tienda, se conecta a un 'OrderId'.
  // - Si es una mensualidad automática del sistema, 'orderId' queda NULL porque no nace de una compra.
  orderId String? @unique @db.VarChar(255)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  concept ConceptType
  amount  Decimal            @db.Decimal(10, 2)
  dueDate DateTime           @db.Date
  status  PaymentOrderStatus @default(pending) // Estado del dinero

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[] // Una orden de pago puede tener varios intentos de transacciones

  @@map("payment_orders")
}

// =========================================================================
// 🎯 3. TABLA DE TRANSACCIONES (CAJA / CONTROL DE EFECTIVO Y BANCOS)
// =========================================================================

model Transaction {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(36)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId String?  @db.VarChar(36)
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // 🔗 Conexión con la Orden de Pago: Toda transacción debe saldar una deuda (Orden de Pago)
  paymentOrderId String       @db.VarChar(255)
  paymentOrder   PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  concept ConceptType
  amount  Decimal           @db.Decimal(10, 2)
  method  PaymentMethod
  status  TransactionStatus @default(pending)

  // Datos de auditoría bancaria (Opcionales pero recomendados para Transferencias/Pago Móvil)
  referenceNumber String? @db.VarChar(100)
  bankName        String? @db.VarChar(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transactions")
}

model WeeklySchedule {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Almacena el objeto WeeklySchedule completo (Dias y sus bloques de horas)
  // Ej: { "lunes": [{ "id": "...", "startTime": "14:30", "endTime": "16:00", "label": "Salsa Casino" }] }
  schedule Json    @default("{\"lunes\": [], \"martes\": [], \"miércoles\": [], \"jueves\": [], \"viernes\": [], \"sábado\": [], \"domingo\": []}")
  // Relación con el Grupo
  group    Group?  @relation(fields: [groupId], references: [id])
  groupId  String?

  // Relación con el Salón de clases (Para saber qué salón está ocupado en este horario)
  classroom   Classroom? @relation(fields: [classroomId], references: [id])
  classroomId String?

  @@map("schedules")
}

model Group {
  id                 String           @id @default(uuid())
  name               String           @unique
  style              String?
  usedSlots          Int              @default(1)
  totalNumberOfSlots Int              @default(1)
  category           GroupCategory    @default(baby)
  instructorId       String?          @db.VarChar(36)
  instructor         User?            @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  classroomId        String?
  classroom          Classroom?       @relation(fields: [classroomId], references: [id])
  // Relación inversa: Un salón puede albergar múltiples grupos
  schedules          WeeklySchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

model Classroom {
  id          String          @id @default(uuid())
  address     String          @db.Text
  name        String          @unique
  maxCapacity Int
  type        ClassroomType
  status      ClassroomStatus @default(active)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relación inversa: Un salón puede albergar múltiples grupos
  groups    Group[]
  // Relación inversa añadida: Un salón puede tener muchos horarios registrados
  schedules WeeklySchedule[]

  @@map("classrooms")
}

// ==================== ENUMS CORREGIDOS Y SEPARADOS ====================

enum GroupCategory {
  baby      @map("Baby")
  childrens @map("Infantil")
  youth     @map("Juvenil")
  adult     @map("Adulto")
}

enum ConceptType {
  monthly_payment @map("Mensualidad")
  tuition         @map("Matrícula")
  locker_room     @map("Vestuario")
  ticket          @map("Entradas Gala")
}

enum PaymentMethod {
  bank_transfer        @map("Transferencia")
  credit_or_debit_card @map("Tarjeta")
  cash                 @map("Efectivo")
  mobile_payment       @map("Pago Móvil")
}

// 🎯 Estados específicos para la entrega física de productos
enum OrderStatus {
  pending_preparation @map("Pendiente por Preparar")
  ready_for_delivery  @map("Listo para Entregar")
  delivered           @map("Entregado")
  canceled            @map("Cancelado")
}

// 🎯 Estados específicos para el flujo del dinero adeudado
enum PaymentOrderStatus {
  pending  @map("Pendiente")
  paid     @map("Pagada")
  defeated @map("Vencida")
  annulled @map("Anulada")
}

// 🎯 Estados específicos para la verificación bancaria de la caja
enum TransactionStatus {
  approved @map("Aprobado")
  pending  @map("Pendiente")
  refused  @map("Rechazado")
}

enum ProfileType {
  representative @map("Representante")
  student        @map("Alumno")
}

enum Kinship {
  son      @map("Hijo")
  daughter @map("Hija")
  nephew   @map("Sobrino")
  niece    @map("Sobrina")
  tutored  @map("Tutorado")
  other    @map("Otro")
}

enum ClassroomType {
  mirrors  @map("Espejos")
  urban    @map("Urbano")
  free     @map("Libre")
  theories @map("Teorias") // Prisma no recomienda caracteres con tildes en identificadores de Enum
}

enum ClassroomStatus {
  active      @map("Activo")
  maintenance @map("Mantenimiento")
}
